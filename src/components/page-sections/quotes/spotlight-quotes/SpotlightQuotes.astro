---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";

type QuoteItem = {
  text?: string;
  label?: string;
};

const {
  eyebrow = "",
  heading = "",
  subtext = "",
  quotes = [] as QuoteItem[],
  sectionLabel,
  colorScheme = "inherit",
  backgroundColor,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["spotlight-quotes", className]}
  label={sectionLabel}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="4xl"
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    class="eyebrow"
    alignmentHorizontal="center"
    data-prop="eyebrow"
    text={eyebrow}
  />
  <Heading
    level="h2"
    size="xl"
    alignmentHorizontal="center"
    data-prop="heading"
  >
    {heading}
  </Heading>
  <SimpleText
    class="quotes-intro"
    alignmentHorizontal="center"
    data-prop="subtext"
    text={subtext}
  />
  <div
    class="quotes-grid"
    data-children-prop="quotes"
  >
    {
      quotes.map((quote) => (
        <article
          class="spotlight-card"
          data-quote-card
          data-editable="array-item"
          data-id="page-sections/quotes/spotlight-quotes/item"
        >
          <p data-prop="text">{quote.text || "Memorable line placeholder."}</p>
          <span
            class="spotlight-card-label"
            data-prop="label"
          >
            {quote.label || "Quote to be added"}
          </span>
        </article>
      ))
    }
  </div>
</CustomSection>

<style is:global>
  @layer page-sections {
    .spotlight-quotes {
      background: color-mix(in srgb, var(--color-bg-surface) 70%, var(--color-hero));

      .quotes-intro {
        color: var(--color-text-muted);
        margin-inline: auto;
        max-width: 38rem;
      }

      .quotes-grid {
        display: grid;
        gap: var(--spacing-lg);
        grid-template-columns: repeat(3, 1fr);
        margin-top: var(--spacing-2xl);
      }

      .spotlight-card {
        background: var(--color-bg-surface);
        border: 1px solid color-mix(in srgb, var(--color-brand) 20%, transparent);
        border-radius: var(--radius-md);
        box-shadow: 0 1.5rem 3rem color-mix(in srgb, var(--color-hero) 18%, transparent);
        display: flex;
        flex-direction: column;
        min-height: 15rem;
        padding: var(--spacing-xl);
        position: relative;

        &::before {
          background: var(--color-spotlight);
          content: "";
          height: 0.25rem;
          left: var(--spacing-xl);
          position: absolute;
          top: 0;
          width: 3rem;
        }

        p {
          color: var(--color-text-strong);
          font-family: var(--font-headings);
          font-size: var(--font-size-xl);
          line-height: 1.35;
          margin-block: 0 var(--spacing-xl);
        }
      }

      .spotlight-card-label {
        color: var(--color-brand-muted);
        font-size: var(--font-size-xs);
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      @media (width < 760px) {
        .quotes-grid {
          grid-template-columns: 1fr;
        }

        .spotlight-card {
          min-height: 12rem;
        }
      }
    }
  }
</style>
