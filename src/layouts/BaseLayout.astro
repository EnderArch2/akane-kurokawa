---
import { ClientRouter } from "astro:transitions";
import { fade } from "astro:transitions";
import SeoHead from "@components/utils/SeoHead.astro";
import StructuredData from "@components/utils/StructuredData.astro";
import seoData from "@data/seo.json";
import "@styles/style.css";
import SiteFonts from "@layouts/SiteFonts.astro";
import VideoElements from "@components/utils/VideoElements.astro";

export interface Props {
  title: string;
  description?: string | null;
  keywords?: string[] | null;
  image?: string | null;
  canonical?: string | null;
  type?: "website" | "article";
  article?: {
    publishedTime?: string | null;
    modifiedTime?: string | null;
    author?: string | string[] | null;
    tags?: string[] | null;
  } | null;
  noindex?: boolean;
}

const props = Astro.props;
---

<!doctype html>
<html
  lang="en"
  data-theme="light"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link
      rel="icon"
      type="image/webp"
      href="/images/logo.webp"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <style is:inline>
      @layer reset, base, components, page-sections, utils, overrides;
    </style>

    <SiteFonts />

    {
      import.meta.env.DEV ? (
        <script
          type="module"
          src="/@vite/client"
        />
      ) : null
    }

    <script>
      if (window.inEditorMode) {
        import("../../live-editing");
        import("../../editor-live-sync");
      }
    </script>

    <SeoHead
      site={seoData}
      title={props.title}
      description={props.description}
      keywords={props.keywords}
      image={props.image}
      canonical={props.canonical}
      type={props.type}
      article={props.article}
      noindex={props.noindex}
    />

    <StructuredData site={seoData} />

    <link
      rel="sitemap"
      type="application/xml"
      title="Sitemap"
      href="/sitemap-index.xml"
    />

    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <div transition:animate={fade({ duration: "0.2s" })}>
      <slot />
    </div>
    <VideoElements />
    <script>
      // Akane Kurokawa tribute — GSAP animations for all sections
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      function initAkaneAnimations() {
        const mm = gsap.matchMedia();

        // These visual effects are intentionally enabled regardless of the user's
        // prefers-reduced-motion setting.
        mm.add("all", () => {
          // ── Hero entrance — word-by-word stagger ─────────────
          const heroSection = document.querySelector(".akane-hero");
          if (heroSection) {
            const h1 = heroSection.querySelector("h1");
            const subtext = heroSection.querySelector(".subtext");
            const eyebrow = heroSection.querySelector(".eyebrow");
            const banner = heroSection.querySelector(".hero-banner-placeholder");

            // Set initial hidden state for banner
            if (banner) {
              gsap.set(banner, { autoAlpha: 0, y: 20 });
            }

            if (h1) {
              // Split h1 text into word spans without losing the element
              const rawText = h1.textContent?.trim() ?? "";
              const words = rawText.split(/\s+/);
              const headingText = h1.querySelector(".heading-text");
              if (headingText && words.length > 0) {
                headingText.innerHTML = words
                  .map((w) => `<span class="akane-word" style="display:inline-block;">${w}</span>`)
                  .join(" ");

                gsap.from(".akane-hero .akane-word", {
                  autoAlpha: 0,
                  y: 30,
                  duration: 0.55,
                  stagger: 0.08,
                  ease: "power3.out",
                  delay: 0.2,
                });
              }
            }

            if (eyebrow) {
              gsap.from(eyebrow, {
                autoAlpha: 0,
                duration: 0.4,
                ease: "power2.out",
              });
            }

            if (subtext) {
              gsap.from(subtext, {
                autoAlpha: 0,
                y: 16,
                duration: 0.5,
                ease: "power2.out",
                delay: 0.7,
              });
            }

            // Animate banner TO visible state
            if (banner) {
              gsap.to(banner, {
                autoAlpha: 1,
                y: 0,
                duration: 0.6,
                ease: "power2.out",
                delay: 0.9,
              });
            }
          }

          // ── Feature-split sections — typing animation + image slide ──
          const featureSplits = document.querySelectorAll(".feature-split");
          featureSplits.forEach((section, index) => {
            const isReverse = section.classList.contains("reverse");
            const splitLayout = section.querySelector(".feature-split-layout");
            const heading = section.querySelector("h2");
            const textContent = section.querySelector(".subtext");
            const image = section.querySelector(".feature-split-image");

            // Animate heading
            if (heading) {
              gsap.from(heading, {
                scrollTrigger: {
                  trigger: section,
                  start: "top 75%",
                  toggleActions: "play none none reverse",
                },
                autoAlpha: 0,
                y: 30,
                duration: 0.6,
                ease: "power2.out",
              });
            }

            // Typing animation for paragraphs in subtext
            if (textContent) {
              const paragraphs = textContent.querySelectorAll("p");

              paragraphs.forEach((p, pIndex) => {
                const text = p.textContent || "";
                p.textContent = "";
                p.style.opacity = "1";

                const chars = text.split("");
                const charSpans = chars.map((char) => {
                  const span = document.createElement("span");
                  span.textContent = char;
                  span.style.opacity = "0";
                  return span;
                });

                charSpans.forEach((span) => p.appendChild(span));

                gsap.to(charSpans, {
                  scrollTrigger: {
                    trigger: section,
                    start: "top 70%",
                    toggleActions: "play none none reverse",
                  },
                  opacity: 1,
                  duration: 0.02,
                  stagger: 0.012,
                  ease: "none",
                  delay: 0.3 + pIndex * 0.5,
                });
              });
            }

            // Image slide animation
            if (image) {
              // For reverse sections: slide from LEFT (-x), otherwise from RIGHT (+x)
              const slideFrom = isReverse ? -80 : 80;

              gsap.from(image, {
                scrollTrigger: {
                  trigger: section,
                  start: "top 80%",
                  toggleActions: "play none none reverse",
                },
                x: slideFrom,
                autoAlpha: 0,
                duration: 0.9,
                ease: "power3.out",
                delay: 0.2,
              });

              // Subtle parallax on scroll
              const imgElement = image.querySelector("img");
              if (imgElement) {
                gsap.to(imgElement, {
                  scrollTrigger: {
                    trigger: section,
                    start: "top bottom",
                    end: "bottom top",
                    scrub: 1,
                  },
                  y: -40,
                  ease: "none",
                });
              }
            }
          });

          // ── Gallery section — stagger tiles with scale effect ──
          const gallerySection = document.querySelector(".placeholder-gallery");
          if (gallerySection) {
            const heading = gallerySection.querySelector("h2");
            const subtext = gallerySection.querySelector(".gallery-intro");
            const tiles = gallerySection.querySelectorAll(".gallery-tile");

            if (heading) {
              gsap.from(heading, {
                scrollTrigger: {
                  trigger: gallerySection,
                  start: "top 75%",
                  toggleActions: "play none none reverse",
                },
                autoAlpha: 0,
                y: 30,
                duration: 0.6,
                ease: "power2.out",
              });
            }

            if (subtext) {
              gsap.from(subtext, {
                scrollTrigger: {
                  trigger: gallerySection,
                  start: "top 75%",
                  toggleActions: "play none none reverse",
                },
                autoAlpha: 0,
                y: 20,
                duration: 0.6,
                delay: 0.2,
                ease: "power2.out",
              });
            }

            if (tiles.length > 0) {
              gsap.from(tiles, {
                scrollTrigger: {
                  trigger: gallerySection,
                  start: "top 70%",
                  toggleActions: "play none none reverse",
                },
                autoAlpha: 0,
                scale: 0.85,
                y: 40,
                duration: 0.7,
                stagger: {
                  amount: 0.6,
                  from: "start",
                },
                ease: "back.out(1.2)",
              });
            }
          }

          // ── Quotes section — slide from bottom one by one ──
          const quotesSection = document.querySelector(".spotlight-quotes");
          if (quotesSection) {
            const heading = quotesSection.querySelector("h2");
            const subtext = quotesSection.querySelector(".quotes-intro");
            const quoteCards = quotesSection.querySelectorAll(".spotlight-card");

            if (heading) {
              gsap.from(heading, {
                scrollTrigger: {
                  trigger: quotesSection,
                  start: "top 75%",
                  toggleActions: "play none none reverse",
                },
                autoAlpha: 0,
                y: 30,
                duration: 0.6,
                ease: "power2.out",
              });
            }

            if (subtext) {
              gsap.from(subtext, {
                scrollTrigger: {
                  trigger: quotesSection,
                  start: "top 75%",
                  toggleActions: "play none none reverse",
                },
                autoAlpha: 0,
                y: 20,
                duration: 0.6,
                delay: 0.15,
                ease: "power2.out",
              });
            }

            if (quoteCards.length > 0) {
              gsap.from(quoteCards, {
                scrollTrigger: {
                  trigger: quotesSection,
                  start: "top 65%",
                  toggleActions: "play none none reverse",
                },
                autoAlpha: 0,
                y: 80,
                duration: 0.8,
                stagger: 0.25,
                ease: "power3.out",
              });
            }
          }

          // ── CTA section — zoom in effect ──
          const ctaSection = document.querySelector(".cta-center");
          if (ctaSection) {
            const heading = ctaSection.querySelector("h2");
            const subtext = ctaSection.querySelector(".subtext");

            gsap.from([heading, subtext], {
              scrollTrigger: {
                trigger: ctaSection,
                start: "top 80%",
                toggleActions: "play none none reverse",
              },
              autoAlpha: 0,
              scale: 0.9,
              duration: 0.8,
              stagger: 0.15,
              ease: "power2.out",
            });
          }
        });
      }

      // Run on first load and after Astro view transitions navigate
      initAkaneAnimations();
      document.addEventListener("astro:after-swap", () => {
        ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
        initAkaneAnimations();
      });
    </script>
    <script>
      // Smooth scroll for navigation anchor links
      function initSmoothScroll() {
        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener("click", function (e) {
            const href = this.getAttribute("href");
            if (href === "#") return;

            const targetId = href.substring(1);
            const targetElement = document.getElementById(targetId);

            if (targetElement) {
              e.preventDefault();
              targetElement.scrollIntoView({
                behavior: "smooth",
                block: "start",
              });

              // Update URL without jumping
              if (history.pushState) {
                history.pushState(null, null, href);
              }
            }
          });
        });
      }

      initSmoothScroll();
      document.addEventListener("astro:after-swap", () => {
        initSmoothScroll();
      });
    </script>
  </body>
</html>
